domain Pacing, PACE
subsystem Pacing, P 1-99
class Client Task
attributes
    ID : Task ID {I}
--
class Client Terminated Task Window
attributes
    Sequence : Ordinal {I, R7}
    Timeline : Timeline ID {I, R7}
    Program : Program Name {I, R7}
    Region : Region Name {I, R7}
    Event : Event Code {I, R7}
--
class Controlling Program
attributes
    Name : Program Name {I, R19}
    Organ : Organ Name {I2, R19}
--
class Cued Program
attributes
    Cued program : Program Name {I, R20}
    Controlling program : Program Name {I2, R20}
--
class Event
attributes
    Code : Event Code {I}
--
class Intrinsic Event
attributes
    Code : Event Code {I, R10}
--
class Open Window
attributes
    Task window : Ordinal {I, R6}
    Timeline : Window ID {I2, R6}
    Program : Program Name {I2, R6}
    Region : Region Name {I2, R6}
    Event : Event Code {I2, R6}
--
class Organ
attributes
    Name : Organ Name {I}
--
class Pace Event
attributes
    Code : Event Code {I, R10}
--
class Pace Program
attributes
    Name : Program Name {I}
    Organ : Organ Name {R15}
--
class Pace Timeout Period, PTP
attributes
    ID : PTP ID {I}
    Program : Program Name {I, R14}
    Pace event : Event Code {R12}
    Inhibited : Boolean
    Current duration : Duration
    Next duration : Duration
--
class PTP Cancellation
attributes
    Event : Event Code {I, R11}
    PTP : PTP ID {I, R11}
    Program : Program Name {I, R11}
--
class PTP Initiation
attributes
    Initiating event : Event Code {I, R13}
    PTP : PTP ID {I, R13}
    Program : Program Name {I, R13}
--
class Region
attributes
    Name : Region Name {I}
    Organ : Organ Name {R1}
--
class Region Schedule
attributes
    Program : Program Name {I, R3}
    Region : Region Name {I, R3}
    Event : Event Code {I, R3}
--
class Region Stimulation
attributes
    Name : Region Name {I}
    Organ : Organ Name {R1}
--
class Task Timeline
attributes
    ID : Timeline ID {I}
    Program : Program Name {I, R4}
    Region : Region Name {I, R4}
    Event : Event Code {I, R4}
--
class Task Window
attributes
    Sequence : Ordinal {I}
    Timeline : Timeline ID {I, R5}
    Program : Program Name {I, R5}
    Region : Region Name {I, R5}
    Event : Event Code {I, R5}
    Task to invoke : Task ID {R17}
--
class Timed Task Window
attributes
    Sequence : Ordinal {I, R7}
    Timeline : Timeline ID {I, R7}
    Program : Program Name {I, R7}
    Region : Region Name {I, R7}
    Event : Event Code {I, R7}
    Duration : Duration
--
relationships
    R1
    is an independently managed component of, 1 Organ
    is partitioned by, M Region
    Region.Organ -> Organ.Name
--
    R2
    can be stimulated by, Mc Event
    can stimulate activity in, Mc Region
    1 Region Stimulation
    Region Stimulation.Region -> Region.Name
    Region Stimulation.Event -> Event.Code
--
    R3
    schedules activity after, Mc Region Stimulation
    is scheduing reference point in, Mc Pace Program
    1 Region Schedule
    Region Schedule.Program -> Pace Program.Name
    Region Schedule.(Region, Event) -> Region Stimulation.(Region, Event)
--
    R4
    sequences activity within, 1 Region Schedule
    has activity sequenced by, M Task Timeline
    Task Timeline.(Program, Region, Event) -> Region Schedule.(Program, Region, Event)
--
    R5
    schedules sequence of, M Task Window
    is scheduled to open in sequence, 1 Task Timeline
    Task Window.(Timeline, Program, Region, Event) -> Task Timeline.(ID, Program, Region, Event)
--
    R6
    opens, 1c Task Window
    is opened by, 1c Task Timeline
    1 Open Window
    Open Window.Task window -> Task Window.ID
    Open Window.(Timeline, Program, Region, Event) -> Task Timeline.(ID, Program, Region, Event)
--
    R7
    Task Window +
        Timed Task Window
        Client Terminated Task Window
    <subclass>.(Sequence, Timeline, Program, Region, Event) -> Task Window.(Sequence, Timeline, Program, Region, Event)
--
    R10
    Event +
        Intrinsic Event
        Pace Event
    <subclass>.Code -> Event.Code
--
    R11
    cancels, Mc Pace Timeout Period
    is canceled by, 1c Intrinsic Event
    1 PTP Cancellation
    PTP Cancellation.Event -> Intrinsic Event.Code
    PTP Cancellation.(PTP, Program) -> Pace Timeout Period.(ID, Program)
--
    R12
    requests delivery of, 1 Pace Event
    has delivery requested by, Mc Pace Timeout Period
    Pace Timeout Period.Pace event -> Pace Event.Code
--
    R13
    is initiated by, M Event
    initiates, Mc Pace Timeout Period
    1 PTP Initiation
    PTP Initiation.(PTP, Program) -> Pace Timeout Period.(ID, Program)
    PTP Initiation.Initiating event -> Event.Code
--
    R14
    specifies pace delivery timing with, Mc Pace Timeout Period
    specifies pace delivery timing for, 1 Pace Program
    Pace Timeout Period.Program -> Pace Program.Name
--
    R15
    regulates activity in, 1 Organ
    has activity regulated by, Mc Pace Program
    Pace Program.Organ -> Organ.Name
--
    R17
    invokes, 1 Client Task
    is invoked by, 1 Task Window
    Task Window.Task to invoke -> Client Task.ID
--
    OR18
    before / after, Task Window
    Sequence : I
--
    R19
    is pacing, 1c Organ
    is being paced by, 1c Pace Program
    1 Controlling Program
    Pace Program.Organ -> Organ.Name
    Pace Program.Name -> Pace Program.Name
--
    R20
    is taking control from, 1c Controlling Program
    is handing off control to, 1c Pace Program
    1 Cued Program
    Cued Program.Controlling Program -> Controlling Program.Name
    Cued Program.Cued Program -> Pace Program.Name
--
